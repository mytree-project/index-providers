{
  "name": "mytree/index-providers",
  "description": "Standalone PHP providers for acquiring genealogical indexes from Geneteka, Metryki-Wołyń and BASIA, designed for integration with MyTree and Laravel.",
  "type": "library",
  "keywords": [
    "genealogy",
    "genealogical indexes",
    "geneteka",
    "metryki wolyn",
    "basia",
    "mytree"
  ],
  "homepage": "https://github.com/mytree-project/index-providers",
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "saulgajda",
      "homepage": "https://github.com/mytree-project",
      "role": "Developer"
    }
  ],
  "support": {
    "issues": "https://github.com/mytree-project/index-providers/issues",
    "source": "https://github.com/mytree-project/index-providers"
  },
  "require": {
    "php": "^8.2",
    "ext-dom": "*",
    "guzzlehttp/guzzle": "^7.9",
    "guzzlehttp/psr7": "^2.7",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.0",
    "psr/http-message": "^1.1 || ^2.0"
  },
  "autoload": {
    "psr-4": {
      "MyTree\\IndexProviders\\": "src/"
    }
  },
  "bin": [
    "bin/mytree-index",
    "bin/mytree-index-view"
  ],
  "scripts": {
    "test": "phpunit"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5 || ^12.5 || ^13.0"
  },
  "autoload-dev": {
    "psr-4": {
      "MyTree\\IndexProviders\\Tests\\": "tests/"
    }
  }
}
