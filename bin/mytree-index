#!/usr/bin/env php
<?php

declare(strict_types=1);

require dirname(__DIR__) . '/bootstrap.php';

use MyTree\IndexProviders\Domain\AvailableParish;
use MyTree\IndexProviders\Domain\RecordType;
use MyTree\IndexProviders\Http\DefaultHttpClientFactory;
use MyTree\IndexProviders\Provider\BasiaProvider;
use MyTree\IndexProviders\Provider\GenetekaProvider;
use MyTree\IndexProviders\Provider\WolynMetrykiProvider;
use MyTree\IndexProviders\Storage\JsonCheckpointStore;
use MyTree\IndexProviders\Storage\RawResponseStore;
use MyTree\IndexProviders\Support\ConsoleProgressReporter;
use MyTree\IndexProviders\Support\RateLimiter;
use MyTree\IndexProviders\Writer\JsonlWriter;

function usage(int $exitCode = 0): never
{
    $text = <<<'TXT'
MyTree Index Providers — standalone CLI

Download indexes — Geneteka:
  php bin/mytree-index geneteka \
    --region=06mp --parish-id=4812 --parish=Imbramowice \
    --type=birth --from=1853 --to=1860 --output=var/imbramowice

Download indexes — Metryki-Wołyń:
  php bin/mytree-index wolyn \
    --parish=Szumsk --from=1731 --to=1943 \
    --output=var/szumsk

Bounded search — BASIA:
  php bin/mytree-index basia \
    --surname=Kowalski --name=Jan --from=1880 --to=1900 \
    --type=birth --output=var/basia-kowalski

Discover available parishes — Geneteka, one region:
  php bin/mytree-index geneteka --list-parishes --region=06mp

Discover available parishes — Geneteka, all regions:
  php bin/mytree-index geneteka --list-parishes --all-regions

Discover Geneteka record ids and year coverage for one parish:
  php bin/mytree-index geneteka --availability \
    --region=10pl --parish-id=4257 --type=birth --format=json

Discover available parishes — Metryki-Wołyń:
  php bin/mytree-index wolyn --list-parishes

Discovery options:
  --list-parishes   Return available parishes instead of downloading indexes
  --all-regions     Geneteka only: discover parishes in every region
  --format=table    table (default), json or jsonl
  --save=FILE       Additionally save discovery result to FILE
  --refresh         Ignore cached discovery pages and fetch them again
  --output=DIR      Optional discovery cache directory (default var/discovery-cache)

Common acquisition options:
  --delay-ms=...    Minimum delay between requests (default 2000; BASIA 5000)
  --timeout=...     HTTP timeout in seconds (default 60; BASIA 200)
  --restart         Ignore checkpoints/cache, truncate records.jsonl and fetch again
  --help            Show this help

Geneteka acquisition options:
  --region=...      Region code, e.g. 06mp
  --parish-id=...   Geneteka rid, e.g. 4812
  --parish=...      Human-readable parish name (stored as requested metadata)
  --type=...        One record type: birth, marriage or death
  --from=YYYY       Optional first year
  --to=YYYY         Optional last year
  --surname=...     Primary surname filter
  --name=...        Primary given-name filter
  --surname2=...    Second surname filter
  --name2=...       Second given-name filter
  --exact           Exact surname matching (`exac=1`)
  --exclude-parents Do not search parent fields (`parents=1`)
  --page-size=50    Page size (default 50)
  --availability    Discover type-specific rid values and non-continuous year ranges

BASIA bounded-search options:
  --surname=...     Indexed surname; at least surname, name or place is required
  --name=...        Indexed given name
  --from=YYYY       Optional first year
  --to=YYYY         Optional last year
  --place=...       Optional locality/place filter
  --distance-km=10  Place radius in kilometres (default 10)
  --type=...        Optional type: birth, marriage, death, banns or other
  --similarity=60   Fuzzy-match similarity percentage (0-100, default 60)
  --sex=...         any, male or female
  --relation=...    any, parent_or_spouse, child or other
  --unit-type=...   any, usc, catholic, evangelical or other

Metryki-Wołyń acquisition options:
  --parish=...      Parish name, e.g. Szumsk
  --from=YYYY       First year
  --to=YYYY         Last year
TXT;
    fwrite($exitCode === 0 ? STDOUT : STDERR, $text . PHP_EOL);
    exit($exitCode);
}

/** @return array<string,string|bool> */
function parseOptions(array $args): array
{
    $out = [];
    foreach ($args as $arg) {
        if (!str_starts_with($arg, '--')) {
            continue;
        }
        $arg = substr($arg, 2);
        if (str_contains($arg, '=')) {
            [$key, $value] = explode('=', $arg, 2);
            $out[$key] = $value;
        } else {
            $out[$arg] = true;
        }
    }
    return $out;
}

function required(array $options, string $key): string
{
    $value = $options[$key] ?? null;
    if (!is_string($value) || trim($value) === '') {
        fwrite(STDERR, "Missing required option --$key\n");
        usage(2);
    }
    return trim($value);
}

/** @param array<string,mixed> $data */
function writeJson(string $path, array $data): void
{
    $dir = dirname($path);
    if (!is_dir($dir)) {
        mkdir($dir, 0775, true);
    }
    file_put_contents($path, json_encode($data, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . PHP_EOL);
}

/** @param list<AvailableParish> $parishes */
function renderParishes(array $parishes, string $format): string
{
    $rows = array_map(static fn (AvailableParish $p): array => $p->toArray(), $parishes);
    if ($format === 'json') {
        return json_encode($rows, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . PHP_EOL;
    }
    if ($format === 'jsonl') {
        return implode('', array_map(
            static fn (array $row): string => json_encode($row, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . PHP_EOL,
            $rows,
        ));
    }
    if ($format !== 'table') {
        throw new InvalidArgumentException('Unsupported --format. Use table, json or jsonl.');
    }

    if ($parishes === []) {
        return "No parishes found.\n";
    }
    $isGeneteka = $parishes[0]->provider === 'geneteka';
    if ($isGeneteka) {
        $header = ['REGION', 'ID', 'PARISH'];
        $data = array_map(static fn (AvailableParish $p): array => [$p->regionCode ?? '', $p->providerParishId ?? '', $p->name], $parishes);
    } else {
        $header = ['PARISH', 'BIRTHS', 'MARRIAGES', 'DEATHS', 'CENSUS'];
        $data = array_map(static function (AvailableParish $p): array {
            $entries = is_array($p->metadata['wpisy'] ?? null) ? $p->metadata['wpisy'] : [];
            return [
                $p->name,
                (string) ($entries['births'] ?? ''),
                (string) ($entries['marriages'] ?? ''),
                (string) ($entries['deaths'] ?? ''),
                (string) ($entries['parish_census'] ?? ''),
            ];
        }, $parishes);
    }
    $widths = array_map('strlen', $header);
    foreach ($data as $row) {
        foreach ($row as $i => $cell) {
            $widths[$i] = max($widths[$i], strlen((string) $cell));
        }
    }
    $line = static function (array $row) use ($widths): string {
        $parts = [];
        foreach ($row as $i => $cell) {
            $parts[] = str_pad((string) $cell, $widths[$i]);
        }
        return rtrim(implode('  ', $parts));
    };
    $out = $line($header) . PHP_EOL;
    $out .= $line(array_map(static fn (int $w): string => str_repeat('-', $w), $widths)) . PHP_EOL;
    foreach ($data as $row) {
        $out .= $line($row) . PHP_EOL;
    }
    return $out;
}

/** @param list<\MyTree\IndexProviders\Provider\GenetekaRecordAvailability> $items */
function renderAvailability(array $items, string $format): string
{
    $rows = array_map(static fn ($item): array => $item->jsonSerialize(), $items);
    if ($format === 'json') {
        return json_encode($rows, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . PHP_EOL;
    }
    if ($format === 'jsonl') {
        return implode('', array_map(
            static fn (array $row): string => json_encode($row, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . PHP_EOL,
            $rows,
        ));
    }
    if ($format !== 'table') {
        throw new InvalidArgumentException('Unsupported --format. Use table, json or jsonl.');
    }

    $out = "TYPE      RID    YEAR RANGES" . PHP_EOL;
    $out .= "--------- ------ ----------------------------------------" . PHP_EOL;
    foreach ($items as $item) {
        $ranges = implode(' ', array_map(
            static fn ($range): string => $range->from === $range->to
                ? (string) $range->from
                : $range->from . '-' . $range->to,
            $item->yearRanges,
        ));
        $out .= str_pad($item->recordType->value, 10)
            . str_pad($item->providerParishId, 7)
            . $ranges . PHP_EOL;
    }
    return $out;
}

/** @return list<RecordType> */
function genetekaSupportedRecordTypes(): array
{
    return [RecordType::Birth, RecordType::Marriage, RecordType::Death];
}

function genetekaRecordType(string $value): RecordType
{
    $type = RecordType::tryFrom(strtolower(trim($value)));
    if ($type === null || !in_array($type, genetekaSupportedRecordTypes(), true)) {
        throw new InvalidArgumentException("Unsupported Geneteka record type '$value'. Use birth, marriage or death.");
    }

    return $type;
}

/** @return list<RecordType> */
function basiaSupportedRecordTypes(): array
{
    return [RecordType::Birth, RecordType::Marriage, RecordType::Death, RecordType::Banns, RecordType::Other];
}

function basiaRecordType(string $value): RecordType
{
    $type = RecordType::tryFrom(strtolower(trim($value)));
    if ($type === null || !in_array($type, basiaSupportedRecordTypes(), true)) {
        throw new InvalidArgumentException("Unsupported BASIA record type '$value'. Use birth, marriage, death, banns or other.");
    }

    return $type;
}

$command = $argv[1] ?? null;
if ($command === null || in_array($command, ['help', '--help', '-h'], true)) {
    usage(0);
}
$options = parseOptions(array_slice($argv, 2));
if (isset($options['help'])) {
    usage(0);
}

$discoveryMode = isset($options['list-parishes']);
$restart = isset($options['restart']);
$refresh = isset($options['refresh']) || $restart;
$isBasia = $command === 'basia';
$delayDefault = $isBasia ? BasiaProvider::DEFAULT_MINIMUM_DELAY_MS : 2000;
$timeoutDefault = $isBasia ? BasiaProvider::DEFAULT_TIMEOUT_SECONDS : 60;
$delayMs = max(0, (int) ($options['delay-ms'] ?? $delayDefault));
$timeout = max(5, (int) ($options['timeout'] ?? $timeoutDefault));
$http = DefaultHttpClientFactory::create(
    timeoutSeconds: $timeout,
    retryableMethods: $isBasia ? ['GET', 'HEAD', 'POST'] : ['GET', 'HEAD'],
);
$rateLimiter = new RateLimiter($delayMs);
$progress = new ConsoleProgressReporter();

if ($discoveryMode) {
    $cacheDir = isset($options['output']) && is_string($options['output']) && trim($options['output']) !== ''
        ? rtrim(trim($options['output']), '/')
        : 'var/discovery-cache';
    $checkpoints = new JsonCheckpointStore($cacheDir . '/state/checkpoints.json');
    $rawStore = new RawResponseStore($cacheDir . '/raw');

    try {
        if ($command === 'geneteka') {
            $provider = new GenetekaProvider($http, $checkpoints, $rawStore, $rateLimiter, progress: $progress);
            $parishes = isset($options['all-regions'])
                ? $provider->listAllParishes($refresh)
                : $provider->listParishes(required($options, 'region'), $refresh);
        } elseif ($command === 'wolyn') {
            $provider = new WolynMetrykiProvider($http, $checkpoints, $rawStore, $rateLimiter, progress: $progress);
            $parishes = $provider->listParishes($refresh);
        } else {
            fwrite(STDERR, "Unknown or unsupported discovery command: $command\n");
            usage(2);
        }

        $format = isset($options['format']) && is_string($options['format']) ? strtolower(trim($options['format'])) : 'table';
        $rendered = renderParishes($parishes, $format);
        fwrite(STDOUT, $rendered);
        if (isset($options['save']) && is_string($options['save']) && trim($options['save']) !== '') {
            $savePath = trim($options['save']);
            $dir = dirname($savePath);
            if ($dir !== '.' && !is_dir($dir)) {
                mkdir($dir, 0775, true);
            }
            file_put_contents($savePath, $rendered);
        }
        exit(0);
    } catch (Throwable $e) {
        fwrite(STDERR, '[ERROR] ' . $e->getMessage() . PHP_EOL);
        exit(1);
    }
}

if ($command === 'geneteka' && isset($options['availability'])) {
    $cacheDir = isset($options['output']) && is_string($options['output']) && trim($options['output']) !== ''
        ? rtrim(trim($options['output']), '/')
        : 'var/discovery-cache';
    $provider = new GenetekaProvider(
        $http,
        new JsonCheckpointStore($cacheDir . '/state/checkpoints.json'),
        new RawResponseStore($cacheDir . '/raw'),
        $rateLimiter,
        progress: $progress,
    );
    try {
        $type = genetekaRecordType(required($options, 'type'));
        $items = $provider->discoverAvailability(
            required($options, 'region'),
            $type,
            required($options, 'parish-id'),
            $refresh,
        );
        $format = isset($options['format']) && is_string($options['format']) ? strtolower(trim($options['format'])) : 'table';
        fwrite(STDOUT, renderAvailability($items, $format));
        exit(0);
    } catch (Throwable $e) {
        fwrite(STDERR, '[ERROR] ' . $e->getMessage() . PHP_EOL);
        exit(1);
    }
}

$outputDir = rtrim(required($options, 'output'), '/');
$recordsPath = $outputDir . '/records.jsonl';
$checkpointPath = $outputDir . '/state/checkpoints.json';
if ($restart) {
    @unlink($recordsPath);
    @unlink($checkpointPath);
}
$checkpoints = new JsonCheckpointStore($checkpointPath);
$rawStore = new RawResponseStore($outputDir . '/raw');
$writer = new JsonlWriter($recordsPath, append: !$restart, deduplicate: true);
$startedAt = gmdate(DATE_ATOM);

try {
    if ($command === 'geneteka') {
        $region = required($options, 'region');
        $parishId = required($options, 'parish-id');
        $parish = isset($options['parish']) && is_string($options['parish']) ? trim($options['parish']) : null;
        $typeValue = isset($options['type']) && is_string($options['type']) ? $options['type'] : 'birth';
        $type = genetekaRecordType($typeValue);
        $pageSize = max(1, min(500, (int) ($options['page-size'] ?? 50)));

        $provider = new GenetekaProvider($http, $checkpoints, $rawStore, $rateLimiter, progress: $progress);
        $acquisition = $provider
            ->acquisition()
            ->region($region)
            ->parish($parishId, $parish)
            ->recordType($type)
            ->pageSize($pageSize)
            ->force($restart);

        if (isset($options['from']) && is_string($options['from'])) {
            $acquisition = $acquisition->fromYear((int) $options['from']);
        }
        if (isset($options['to']) && is_string($options['to'])) {
            $acquisition = $acquisition->toYear((int) $options['to']);
        }
        $acquisition = $acquisition->person(
            isset($options['surname']) && is_string($options['surname']) ? $options['surname'] : null,
            isset($options['name']) && is_string($options['name']) ? $options['name'] : null,
        );
        $acquisition = $acquisition->secondPerson(
            isset($options['surname2']) && is_string($options['surname2']) ? $options['surname2'] : null,
            isset($options['name2']) && is_string($options['name2']) ? $options['name2'] : null,
        );
        if (isset($options['exact'])) {
            $acquisition = $acquisition->exact();
        }
        if (isset($options['exclude-parents'])) {
            $acquisition = $acquisition->excludeParents();
        }

        $stats = $acquisition->acquire($writer);
        $config = $acquisition->configuration();
        $providerName = 'geneteka';
    } elseif ($command === 'basia') {
        $provider = new BasiaProvider($http, $checkpoints, $rawStore, $rateLimiter, progress: $progress);
        $search = $provider->search()->force($restart)->person(
            isset($options['surname']) && is_string($options['surname']) ? $options['surname'] : null,
            isset($options['name']) && is_string($options['name']) ? $options['name'] : null,
        );
        if (isset($options['from']) && is_string($options['from'])) {
            $search = $search->fromYear((int) $options['from']);
        }
        if (isset($options['to']) && is_string($options['to'])) {
            $search = $search->toYear((int) $options['to']);
        }
        if (isset($options['place']) && is_string($options['place'])) {
            $search = $search->place($options['place'], max(0, (int) ($options['distance-km'] ?? 10)));
        }
        if (isset($options['type']) && is_string($options['type'])) {
            $search = $search->recordType(basiaRecordType($options['type']));
        }
        if (isset($options['similarity']) && is_string($options['similarity'])) {
            $search = $search->similarity((int) $options['similarity']);
        }
        if (isset($options['sex']) && is_string($options['sex'])) {
            $search = $search->sex($options['sex']);
        }
        if (isset($options['relation']) && is_string($options['relation'])) {
            $search = $search->relation($options['relation']);
        }
        if (isset($options['unit-type']) && is_string($options['unit-type'])) {
            $search = $search->unitType($options['unit-type']);
        }

        $stats = $search->acquire($writer);
        $config = $search->configuration();
        $providerName = 'basia';
    } elseif ($command === 'wolyn') {
        $parish = required($options, 'parish');
        $from = (int) required($options, 'from');
        $to = (int) required($options, 'to');
        if ($from < 1500 || $to > 2100) {
            fwrite(STDERR, "Refusing suspicious year range $from..$to.\n");
            exit(2);
        }

        $provider = new WolynMetrykiProvider($http, $checkpoints, $rawStore, $rateLimiter, progress: $progress);
        $stats = $provider->acquire($parish, $from, $to, $writer, $restart);
        $config = compact('parish', 'from', 'to');
        $providerName = 'wolyn-metryki';
    } else {
        fwrite(STDERR, "Unknown command: $command\n");
        usage(2);
    }

    $writer->close();
    $manifest = [
        'schema' => 'mytree.index-acquisition-manifest.v1',
        'provider' => $providerName,
        'started_at' => $startedAt,
        'finished_at' => gmdate(DATE_ATOM),
        'configuration' => $config,
        'minimum_delay_ms' => $delayMs,
        'records_file' => 'records.jsonl',
        'checkpoint_file' => 'state/checkpoints.json',
        'raw_directory' => 'raw',
        'stats' => $stats->toArray(),
        'writer' => [
            'written_this_run' => $writer->writtenCount(),
            'duplicates_skipped_this_run' => $writer->duplicateCount(),
        ],
    ];
    writeJson($outputDir . '/manifest.json', $manifest);
    fwrite(STDOUT, json_encode($manifest, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) . PHP_EOL);
} catch (Throwable $e) {
    $writer->close();
    fwrite(STDERR, '[ERROR] ' . $e->getMessage() . PHP_EOL);
    exit(1);
}
